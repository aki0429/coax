+
+//! Cancellable channel acquisition; sockets are registered before HTTP headers.
+use coax::daemon::{Connection, Daemon, Endpoint, Interrupter};
+use coax::http::{self, Response};
+use coax::launch::{Claim, Launcher};
+use std::io::{self, Read, Write};
+use std::sync::{
+    Arc, Mutex,
+    atomic::{AtomicBool, Ordering},
+};
+use std::time::{Duration, Instant};
+#[derive(Debug, Default)]
+pub struct Cancel {
+    stopped: AtomicBool,
+    connections: Mutex<Vec<Interrupter>>,
+}
+impl Cancel {
+    pub fn stop(&self) {
+        self.stopped.store(true, Ordering::SeqCst);
+        for socket in self.connections.lock().unwrap().iter() {
+            socket.interrupt();
+        }
+    }
+    pub fn check(&self) -> io::Result<()> {
+        if self.stopped.load(Ordering::SeqCst) {
+            Err(io::Error::new(
+                // Interrupted is retried by std::io::read_until, defeating cancellation.
+                io::ErrorKind::ConnectionAborted,
+                "selection cancelled",
+            ))
+        } else {
+            Ok(())
+        }
+    }
+    fn register(&self, socket: Interrupter) -> io::Result<()> {
+        let mut connections = self.connections.lock().unwrap();
+        self.check()?;
+        connections.push(socket);
+        Ok(())
+    }
+    pub fn ensure_running(&self, daemon: &Daemon, launcher: &Launcher) -> io::Result<String> {
+        self.check()?;
+        if let Ok(version) = daemon.version() {
+            return Ok(version);
+        }
+        let Endpoint::Socket(socket) = daemon.endpoint() else {
+            return daemon.version();
+        };
+        let deadline = Instant::now() + Duration::from_secs(30);
+        let mut claim = None;
+        loop {
+            self.check()?;
+            if claim.is_none()
+                && let Some(taken) = Claim::take(socket)
+            {
+                self.check()?;
+                if let Ok(version) = daemon.version() {
+                    return Ok(version);
+                }
+                launcher.start(socket)?;
+                claim = Some(taken);
+            }
+            match daemon.version() {
+                Ok(version) => return Ok(version),
+                Err(reason) if Instant::now() >= deadline => return Err(reason),
+                Err(_) => std::thread::sleep(Duration::from_millis(50)),
+            }
+        }
+    }
+}
+/// Short read polls preserve partially received HTTP headers while checking cancellation.
+/// Windows shutdown on a cloned socket need not wake an already pending recv.
+#[derive(Debug)]
+pub struct CancellableConnection {
+    inner: Connection,
+    cancel: Option<Arc<Cancel>>,
+    last_read: Instant,
+    deadline: Instant,
+    acquiring: AtomicBool,
+}
+impl Read for CancellableConnection {
+    fn read(&mut self, buffer: &mut [u8]) -> io::Result<usize> {
+        loop {
+            if let Some(cancel) = &self.cancel {
+                cancel.check()?;
+            }
+            match self.inner.read(buffer) {
+                Err(reason)
+                    if matches!(
+                        reason.kind(),
+                        io::ErrorKind::TimedOut | io::ErrorKind::WouldBlock
+                    ) =>
+                {
+                    if (self.acquiring.load(Ordering::Relaxed) && Instant::now() >= self.deadline)
+                        || (!self.acquiring.load(Ordering::Relaxed)
+                            && self.last_read.elapsed() >= Duration::from_secs(5))
+                    {
+                        return Err(reason);
+                    }
+                }
+                Ok(read) => {
+                    if read > 0 {
+                        self.last_read = Instant::now();
+                    }
+                    return Ok(read);
+                }
+                other => return other,
+            }
+        }
+    }
+}
+impl Write for CancellableConnection {
+    fn write(&mut self, buffer: &[u8]) -> io::Result<usize> {
+        self.inner.write(buffer)
+    }
+    fn flush(&mut self) -> io::Result<()> {
+        self.inner.flush()
+    }
+}
+pub fn stream(
+    daemon: &Daemon,
+    properties: &[(&str, String)],
+    cancel: Option<&Arc<Cancel>>,
+) -> io::Result<(Response<CancellableConnection>, Interrupter)> {
+    if let Some(cancel) = cancel {
+        cancel.check()?;
+    }
+    let inner = Connection::to(daemon.endpoint())?;
+    inner.set_read_timeout(Duration::from_millis(100))?;
+    let interrupter = inner.interrupter()?;
+    if let Some(cancel) = cancel {
+        cancel.register(interrupter.clone())?;
+    }
+    let connection = CancellableConnection {
+        inner,
+        cancel: cancel.cloned(),
+        last_read: Instant::now(),
+        deadline: Instant::now() + Duration::from_secs(5),
+        acquiring: AtomicBool::new(true),
+    };
+    let priority = daemon.priority().to_string();
+    let headers = if daemon.priority() == 0 {
+        vec![]
+    } else {
+        vec![("X-Coax-Priority", priority.as_str())]
+    };
+    let host = match daemon.endpoint() {
+        Endpoint::Socket(_) => "coaxd",
+        Endpoint::Network(address) => address.as_str(),
+    };
+    let mut response = http::get(
+        connection,
+        &format!("/stream{}", http::query(properties)),
+        host,
+        &headers,
+    )?;
+    if let Some(cancel) = cancel {
+        cancel.check()?;
+    }
+    if response.status != 200 {
+        let body = response.read_to_end().unwrap_or_default();
+        return Err(io::Error::other(format!(
+            "channel refused: {} {} {}",
+            response.status,
+            response.reason,
+            String::from_utf8_lossy(&body)
+        )));
+    }
+    response.get_ref().acquiring.store(false, Ordering::Relaxed);
+    Ok((response, interrupter))
+}
