+    #[test]
+    fn an_ended_local_stream_is_reacquired_without_reopening_the_driver() {
+        let listener = TcpListener::bind("127.0.0.1:0").unwrap();
+        let address = listener.local_addr().unwrap().to_string();
+        listener.set_nonblocking(true).unwrap();
+        let served = thread::spawn(move || {
+            let deadline = Instant::now() + Duration::from_secs(5);
+            let mut versions = 0;
+            let mut streams = 0;
+            while streams < 2 && Instant::now() < deadline {
+                let Ok((mut socket, _)) = listener.accept() else {
+                    thread::sleep(Duration::from_millis(5));
+                    continue;
+                };
+                socket
+                    .set_read_timeout(Some(Duration::from_secs(1)))
+                    .unwrap();
+                let mut request = Vec::new();
+                let mut byte = [0u8; 1];
+                while !request.ends_with(b"\r\n\r\n") {
+                    if socket.read(&mut byte).unwrap_or(0) == 0 {
+                        break;
+                    }
+                    request.push(byte[0]);
+                }
+                if request.starts_with(b"GET /version ") {
+                    versions += 1;
+                    socket
+                        .write_all(b"HTTP/1.1 200 OK\r\nContent-Length: 4\r\n\r\ntest")
+                        .unwrap();
+                } else if request.starts_with(b"GET /stream?") {
+                    streams += 1;
+                    let mut packet = [0u8; 188];
+                    packet[0] = 0x47;
+                    packet[4] = streams;
+                    socket.write_all(b"HTTP/1.1 200 OK\r\nContent-Type: video/mp2t\r\nTransfer-Encoding: chunked\r\n\r\nbc\r\n").unwrap();
+                    socket.write_all(&packet).unwrap();
+                    socket.write_all(b"\r\n0\r\n\r\n").unwrap();
+                }
+            }
+            (versions, streams)
+        });
+        let mut driver = Driver::new(
+            lineup(),
+            "coax",
+            Daemon::new(Endpoint::Network(address)),
+            Some(Launcher::default()),
+            Vec::new(),
+            TunerSettings::default(),
+        );
+        assert!(driver.set_channel(0, 0));
+        assert_eq!(driver.wait_ts_stream(1000), 0);
+        assert_eq!(driver.take_stream().unwrap()[4], 1);
+        driver.reconnect_after = Instant::now();
+        let deadline = Instant::now() + Duration::from_secs(3);
+        let mut restored = false;
+        while Instant::now() < deadline {
+            if let Some(packet) = driver.take_stream() {
+                restored = packet[4] == 2;
+                if restored {
+                    break;
+                }
+            }
+            thread::sleep(Duration::from_millis(5));
+        }
+        assert!(restored, "the driver did not restore the ended stream");
+        let (versions, streams) = served.join().unwrap();
+        assert_eq!(streams, 2);
+        assert_eq!(versions, 2, "each acquisition must recheck daemon liveness");
+    }
